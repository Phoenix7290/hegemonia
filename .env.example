# Hegemonia server
PORT=2567
HOST=::

# Local PostgreSQL (replace the password outside development)
POSTGRES_DB=hegemonia
POSTGRES_USER=hegemonia
POSTGRES_PASSWORD=hegemonia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hegemonia:hegemonia@localhost:5432/hegemonia

# Optional production tuning
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# MIGRATION_DATABASE_URL=postgresql://migration_user:password@localhost:5432/hegemonia

# Identity, browser security and profile media
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
AVATAR_DIR=data/avatars
# Set COOKIE_SECURE=true and WEB_ORIGIN=https://your-domain when served over HTTPS.

# Optional WebRTC ICE servers as a JSON array. STUN is used by default; add TURN for restrictive networks.
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"replace-me"}]
