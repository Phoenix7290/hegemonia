{
  "name": "@hegemonia/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:rollback": "tsx src/migrate.ts down",
    "test:db": "vitest run src/db.test.ts",
    "test:identity": "vitest run src/identity.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@colyseus/core": "^0.16.4",
    "@colyseus/ws-transport": "^0.16.2",
    "@hegemonia/engine": "workspace:*",
    "@hegemonia/maps": "workspace:*",
    "@hegemonia/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1"
  }
}
