{
  "name": "hegemonia",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted geopolitical strategy board game (War/Risk clone)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @hegemonia/web test:e2e",
    "test:ai": "pnpm --filter @hegemonia/web test:ai",
    "sim": "pnpm --filter @hegemonia/engine sim",
    "setup:audio": "python3 scripts/download-audio.py",
    "dev": "pnpm --parallel --filter @hegemonia/server --filter @hegemonia/web dev",
    "dev:server": "pnpm --filter @hegemonia/server dev",
    "dev:web": "pnpm --filter @hegemonia/web dev",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/topojson-server": "^3.0.4",
    "topojson-server": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
